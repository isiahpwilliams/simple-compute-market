# Registry profile for the inference stack's registry, `inference-registry`, in
# the inference lane and the full local stack: ACTIVE_PROFILES=inference-registry,
# read from CONFIG_DIRECTORY=/etc/arkhai/registry (compose.inference-local.yml).
#
# Public development values, never for a public network; see
# dev-env/identities/README.md. The identifier is the Ed25519 identity of the
# signer credential compose.inference-local.yml mounts,
# dev-env/identities/inference-registry.ed25519.
REGISTRY_AUTHORITY_ID=inference-registry
REGISTRY_AUTHORITY_SCHEME=ed25519
REGISTRY_AUTHORITY_IDENTIFIER=QpkX0mKYYK2PMdhAweeYEpDGzdX_htGTGmZq-L0e9r8
REGISTRY_AUTHORITY_CREDENTIAL_FILE=/run/secrets/arkhai/registry-identity/credential
REGISTRY_DESCRIPTOR_BASE_URL=http://localhost:8100
REGISTRY_DESCRIPTOR_DISPLAY_NAME="Local Inference Registry"
REGISTRY_DESCRIPTOR_OPERATOR_IDENTITY="Arkhai local development"
# The inference schema the registry image carries, in place of its default
# compute specification.
REGISTRY_FILTER_SPEC_PATH=/app/filter-spec-inference.yaml
